<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="build.xsl"?>
<!--
  XML build manifest for the static SVG host.

  Regenerate the build script after changing this file:

    xsltproc build.xsl build.xml > build.sh
    chmod +x build.sh

  Then run ./build.sh to mirror every .svgz file to its .svg.gz target.
-->
<build>
  <name>nebulasvgz</name>
  <description>Static SVG host artifacts mirrored as .svg.gz for GitHack.</description>

  <artifacts>
    <artifact source="index.svgz" target="index.svg.gz"/>

    <artifact source="en_US/index.svgz" target="en_US/index.svg.gz"/>
    <artifact source="en_US/catalog/index.svgz" target="en_US/catalog/index.svg.gz"/>
    <artifact source="en_US/catalog/package/index.svgz" target="en_US/catalog/package/index.svg.gz"/>
    <artifact source="en_US/catalog/pagination/index.svgz" target="en_US/catalog/pagination/index.svg.gz"/>
    <artifact source="en_US/games/index.svgz" target="en_US/games/index.svg.gz"/>
    <artifact source="en_US/settings/appearance/index.svgz" target="en_US/settings/appearance/index.svg.gz"/>
    <artifact source="en_US/settings/credits/index.svgz" target="en_US/settings/credits/index.svg.gz"/>
    <artifact source="en_US/settings/misc/index.svgz" target="en_US/settings/misc/index.svg.gz"/>
    <artifact source="en_US/settings/pr/index.svgz" target="en_US/settings/pr/index.svg.gz"/>
    <artifact source="en_US/settings/tab/index.svgz" target="en_US/settings/tab/index.svg.gz"/>

    <artifact source="jp/index.svgz" target="jp/index.svg.gz"/>
    <artifact source="jp/catalog/index.svgz" target="jp/catalog/index.svg.gz"/>
    <artifact source="jp/catalog/package/index.svgz" target="jp/catalog/package/index.svg.gz"/>
    <artifact source="jp/catalog/pagination/index.svgz" target="jp/catalog/pagination/index.svg.gz"/>
    <artifact source="jp/games/index.svgz" target="jp/games/index.svg.gz"/>
    <artifact source="jp/settings/appearance/index.svgz" target="jp/settings/appearance/index.svg.gz"/>
    <artifact source="jp/settings/credits/index.svgz" target="jp/settings/credits/index.svg.gz"/>
    <artifact source="jp/settings/misc/index.svgz" target="jp/settings/misc/index.svg.gz"/>
    <artifact source="jp/settings/pr/index.svgz" target="jp/settings/pr/index.svg.gz"/>
    <artifact source="jp/settings/tab/index.svgz" target="jp/settings/tab/index.svg.gz"/>
  </artifacts>
</build>
